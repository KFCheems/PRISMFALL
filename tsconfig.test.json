{
  "extends": "./tsconfig.json",
  "include": ["src", "tests", "playwright.config.ts"],
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "paths": {
      "/src/*": ["./src/*"]
    },
    // Test files lean on `any` for the page-side objects they probe; the game itself stays fully strict.
    "noImplicitAny": false
  }
}
